# Copy to .env and replace every change-me value before use.
# .env is gitignored. These values are placeholders, not real secrets or a company domain.

POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog
# Host port published by docker-compose.dev.yml. Use another port if 5432 is taken.
POSTGRES_HOST_PORT=5432

# Host-side API. Compose overrides the host to "postgres" inside the api container.
# If the password contains reserved URL characters, percent-encode them.
DATABASE_URL=postgresql+psycopg://catalog:change-me@127.0.0.1:5432/catalog

# Required when APP_ENV=production. The placeholder is rejected in that mode.
SESSION_SECRET=change-me-to-a-long-random-string

MEDIA_ROOT=/var/lib/catalog/media
MEDIA_PUBLIC_BASE_URL=http://localhost/media

# Placeholder until the client supplies the real domain. Do not invent one.
PUBLIC_SITE_URL=http://localhost

# Server-side Next.js to FastAPI. The browser uses same-origin /api through Nginx.
# Use http://api:8000 inside Compose. Use the loopback URL when Next.js runs on the host.
API_INTERNAL_URL=http://127.0.0.1:8000

# local allows the placeholder secret. production rejects it and requires DEBUG=false.
APP_ENV=local
DEBUG=false
